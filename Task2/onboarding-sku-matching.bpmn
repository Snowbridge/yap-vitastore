<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Onboarding" targetNamespace="http://vitastore.ru/bpmn/onboarding" exporter="handwritten" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Onboarding">
    <bpmn:participant id="Pool_AI" name="AI-сервис SKU Matching" processRef="Process_AI" />
    <bpmn:participant id="Pool_Main" name="Перенос номенклатуры: оркестратор и люди" processRef="Process_Main" />
    <bpmn:participant id="Pool_ERP" name="1С:ERP" processRef="Process_ERP" />
    <bpmn:participant id="Pool_POS" name="Cloud POS (кассовый SaaS)" />
    <bpmn:messageFlow id="Msg_Request" name="Позиции выгрузки" sourceRef="Task_CallAI" targetRef="AI_Start" />
    <bpmn:messageFlow id="Msg_Result" name="Топ-3 кандидата, confidence, риск-флаги" sourceRef="AI_End" targetRef="Task_CallAI" />
    <bpmn:messageFlow id="Msg_To1C" name="Таблица соответствий, новые карточки, остатки" sourceRef="Task_Send1C" targetRef="ERP_Start" />
    <bpmn:messageFlow id="Msg_ToPOS" name="Событие: ассортимент и цены магазина (Kafka)" sourceRef="ERP_End" targetRef="Pool_POS" />
    <bpmn:messageFlow id="Msg_POSAck" name="Ассортимент загружен" sourceRef="Pool_POS" targetRef="Catch_POS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Store" name="Управляющий магазином (купленная сеть)">
        <bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Smoke</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orch" name="Оркестратор онбординга (автоматически)">
        <bpmn:flowNodeRef>Start_Deal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallAI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyAuto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveLabels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send1C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_POS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Smoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Merch" name="Товаровед HQ">
        <bpmn:flowNodeRef>Task_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ConfirmMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ManualMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Found</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM" name="Категорийный менеджер HQ">
        <bpmn:flowNodeRef>Task_CM</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Deal" name="Сделка закрыта, магазин в плане онбординга">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Deal_Msg" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreateCase" name="Создать кейс онбординга и выдать доступ к порталу">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Upload" name="Загрузить выгрузку товаров и остатков на портал (или дать доступ к БД/API)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Export"><bpmn:targetRef>Data_Export</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:dataObject id="Data_Export_Obj" />
    <bpmn:dataObjectReference id="Data_Export" name="Выгрузка товаров и остатков (CSV/XLS/API)" dataObjectRef="Data_Export_Obj" />
    <bpmn:serviceTask id="Task_Validate" name="Проверить выгрузку: схема, дубли, контрольная сумма EAN">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="DIA_Export_Prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Export"><bpmn:sourceRef>Data_Export</bpmn:sourceRef><bpmn:targetRef>DIA_Export_Prop</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Выгрузка корректна?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CallAI" name="Запустить AI-маппинг номенклатуры">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Gw_Split" name="Коридор уверенности">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="Task_ApplyAuto" name="Применить автоматические соответствия">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Audit" name="Выборочный аудит 3% автосоответствий (не меньше 50)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Audit" name="Ошибок больше 1%?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ConfirmMerge" name="">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Confirm" name="Подтвердить соответствие: выбрать из топ-3 кандидатов">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Rejected" name="Все кандидаты отклонены?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ManualMerge" name="">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Manual" name="Ручной разбор: найти аналог в справочнике 1С">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Found" name="Аналог найден?">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CM" name="Решить: новая карточка (черновик от ИИ) или вывод из ассортимента">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gw_Join" name="">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="Task_SaveLabels" name="Сохранить решения людей в обучающую выборку">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Labels"><bpmn:targetRef>Store_Labels</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="Store_Labels" name="Обучающая выборка: синонимы и разметка" />
    <bpmn:sendTask id="Task_Send1C" name="Передать в 1С соответствия, новые карточки и остатки">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_POS" name="Cloud POS загрузил ассортимент">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_POS_Msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Smoke" name="Пробная продажа контрольной выборки ~100 SKU (тестовый чек)">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Smoke" name="Есть расхождения?">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Ready" name="Номенклатура готова к открытию">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start_Deal" targetRef="Task_CreateCase" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Task_CreateCase" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Task_Upload" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_5" name="да" sourceRef="Gw_Valid" targetRef="Task_CallAI" />
    <bpmn:sequenceFlow id="Flow_6" name="нет, отчёт об ошибках" sourceRef="Gw_Valid" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Task_CallAI" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_8" name="от 95%, без флагов" sourceRef="Gw_Split" targetRef="Task_ApplyAuto" />
    <bpmn:sequenceFlow id="Flow_9" name="70-95% или риск-флаг" sourceRef="Gw_Split" targetRef="Gw_ConfirmMerge" />
    <bpmn:sequenceFlow id="Flow_10" name="меньше 70%" sourceRef="Gw_Split" targetRef="Gw_ManualMerge" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="Task_ApplyAuto" targetRef="Task_Audit" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Task_Audit" targetRef="Gw_Audit" />
    <bpmn:sequenceFlow id="Flow_13" name="нет" sourceRef="Gw_Audit" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_14" name="да: весь автокоридор на проверку" sourceRef="Gw_Audit" targetRef="Gw_ConfirmMerge" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Gw_ConfirmMerge" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_16" name="" sourceRef="Task_Confirm" targetRef="Gw_Rejected" />
    <bpmn:sequenceFlow id="Flow_17" name="нет" sourceRef="Gw_Rejected" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_18" name="да" sourceRef="Gw_Rejected" targetRef="Gw_ManualMerge" />
    <bpmn:sequenceFlow id="Flow_19" name="" sourceRef="Gw_ManualMerge" targetRef="Task_Manual" />
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="Task_Manual" targetRef="Gw_Found" />
    <bpmn:sequenceFlow id="Flow_21" name="да" sourceRef="Gw_Found" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_22" name="нет" sourceRef="Gw_Found" targetRef="Task_CM" />
    <bpmn:sequenceFlow id="Flow_23" name="" sourceRef="Task_CM" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_24" name="" sourceRef="Gw_Join" targetRef="Task_SaveLabels" />
    <bpmn:sequenceFlow id="Flow_25" name="" sourceRef="Task_SaveLabels" targetRef="Task_Send1C" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="Task_Send1C" targetRef="Catch_POS" />
    <bpmn:sequenceFlow id="Flow_27" name="" sourceRef="Catch_POS" targetRef="Task_Smoke" />
    <bpmn:sequenceFlow id="Flow_28" name="" sourceRef="Task_Smoke" targetRef="Gw_Smoke" />
    <bpmn:sequenceFlow id="Flow_29" name="нет" sourceRef="Gw_Smoke" targetRef="End_Ready" />
    <bpmn:sequenceFlow id="Flow_30" name="да: позиции на повторную проверку" sourceRef="Gw_Smoke" targetRef="Gw_ConfirmMerge" />
  </bpmn:process>
  <bpmn:process id="Process_AI" isExecutable="false">
    <bpmn:startEvent id="AI_Start" name="Запрос на маппинг">
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="AI_Start_Msg" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="AI_GTIN" name="Точное совпадение по GTIN (штрихкоду)">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:property id="DIA_IndexGTIN_Prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_IndexGTIN"><bpmn:sourceRef>Store_Index</bpmn:sourceRef><bpmn:targetRef>DIA_IndexGTIN_Prop</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AI_Normalize" name="Нормализация названий (YandexGPT): сокращения, бренд, объём">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AI_Vector" name="Векторный поиск top-K по эмбеддингам">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:property id="DIA_IndexVector_Prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_IndexVector"><bpmn:sourceRef>Store_Index</bpmn:sourceRef><bpmn:targetRef>DIA_IndexVector_Prop</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="AI_Rerank" name="Переранжирование кандидатов (LLM), расчёт confidence">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="AI_Risk" name="Риск-правила: цена, категория, штрихкод, объём, маркировка">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:endEvent id="AI_End" name="Результаты маппинга">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:messageEventDefinition id="AI_End_Msg" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Store_Index" name="Индекс номенклатуры VitaStore (pgvector, из 1С)" />
    <bpmn:sequenceFlow id="Flow_31" name="" sourceRef="AI_Start" targetRef="AI_GTIN" />
    <bpmn:sequenceFlow id="Flow_32" name="" sourceRef="AI_GTIN" targetRef="AI_Normalize" />
    <bpmn:sequenceFlow id="Flow_33" name="" sourceRef="AI_Normalize" targetRef="AI_Vector" />
    <bpmn:sequenceFlow id="Flow_34" name="" sourceRef="AI_Vector" targetRef="AI_Rerank" />
    <bpmn:sequenceFlow id="Flow_35" name="" sourceRef="AI_Rerank" targetRef="AI_Risk" />
    <bpmn:sequenceFlow id="Flow_36" name="" sourceRef="AI_Risk" targetRef="AI_End" />
  </bpmn:process>
  <bpmn:process id="Process_ERP" isExecutable="false">
    <bpmn:startEvent id="ERP_Start" name="Пакет соответствий получен">
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ERP_Start_Msg" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ERP_Load" name="Загрузить соответствия штрихкодов и новые карточки">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ERP_Stock" name="Ввести начальные остатки магазина">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ERP_Matrix" name="Сформировать ассортиментную матрицу и цены (прайс VitaStore, Promo Engine)">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ERP_End" name="Ассортимент опубликован в шину">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:messageEventDefinition id="ERP_End_Msg" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_37" name="" sourceRef="ERP_Start" targetRef="ERP_Load" />
    <bpmn:sequenceFlow id="Flow_38" name="" sourceRef="ERP_Load" targetRef="ERP_Stock" />
    <bpmn:sequenceFlow id="Flow_39" name="" sourceRef="ERP_Stock" targetRef="ERP_Matrix" />
    <bpmn:sequenceFlow id="Flow_40" name="" sourceRef="ERP_Matrix" targetRef="ERP_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Onboarding">
    <bpmndi:BPMNPlane id="Plane_Onboarding" bpmnElement="Collab_Onboarding">
      <bpmndi:BPMNShape id="Pool_AI_di" bpmnElement="Pool_AI" isHorizontal="true"><dc:Bounds x="1000" y="120" width="1290" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Main_di" bpmnElement="Pool_Main" isHorizontal="true"><dc:Bounds x="100" y="360" width="4550" height="950" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_ERP_di" bpmnElement="Pool_ERP" isHorizontal="true"><dc:Bounds x="3520" y="1370" width="1110" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_POS_di" bpmnElement="Pool_POS" isHorizontal="true"><dc:Bounds x="100" y="1610" width="4550" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Store_di" bpmnElement="Lane_Store" isHorizontal="true"><dc:Bounds x="130" y="360" width="4520" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Orch_di" bpmnElement="Lane_Orch" isHorizontal="true"><dc:Bounds x="130" y="540" width="4520" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Merch_di" bpmnElement="Lane_Merch" isHorizontal="true"><dc:Bounds x="130" y="740" width="4520" height="410" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CM_di" bpmnElement="Lane_CM" isHorizontal="true"><dc:Bounds x="130" y="1150" width="4520" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Deal_di" bpmnElement="Start_Deal"><dc:Bounds x="202" y="622" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="160" y="663" width="120" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
